{
  "name": "date-inserter",
  "version": "0.7.3",
  "description": "An Obsidian plugin that lets you insert a date at the cursor position using a calendar.",
  "main": "main.js",
  "scripts": {
    "dev": "run-p esbuild sass-build",
    "build": "run-p esbuild:prod sass-build",
    "esbuild": "node esbuild.config.mjs",
    "esbuild:prod": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "sass-build": "sass --no-source-map *.scss styles.css",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "namikaze-40p",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^16.11.6",
    "@types/vanillajs-datepicker": "^1.3.4",
    "cspell": "^8.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "npm-run-all2": "^9.0.2",
    "obsidian": "^1.13.1",
    "prettier": "3.6.2",
    "sass": "^1.71.0",
    "tslib": "2.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "vanillajs-datepicker": "^1.3.4"
  }
}
